generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  title       String
  firstName   String
  lastName    String
  studentId   String?  @unique
  phoneNumber String? // เบอร์โทรศัพท์
  section     String? // กลุ่มเรียน / เซกชัน
  faceData    String? // Base64 encoded face template for 2FA
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sessions TrackingSession[]

  @@map("users")
}

model Section {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "Sec 1", "Sec 2", "Sec 11"
  name      String // e.g. "Section 1 (กลุ่ม 1)"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sections")
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  INTERRUPTED
}

model TrackingSession {
  id            String    @id @default(cuid())
  userId        String
  sessionName   String? // ชื่อการสอบ/เซสชัน
  startTime     DateTime
  endTime       DateTime?
  totalDuration Int? // seconds
  status        String? // COMPLETED, DISCONNECTED, IN_PROGRESS

  // Relations
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackingLogs TrackingLog[]
  statistics   SessionStatistics?

  // Model-specific benchmark logs
  mediapipeLogs       MediaPipeLog[]
  yolov8Logs          Yolov8Log[]
  dlibLogs            DlibLog[]
  openFaceLogs        OpenFaceLog[]
  behaviorFeatureLogs BehaviorFeatureLog[]

  @@index([userId])
  @@index([startTime])
  @@map("tracking_sessions")
}

model TrackingLog {
  id            String        @id @default(cuid())
  sessionId     String
  detectionType DetectionType
  detectionData Json // Flexible JSON data for different detection types
  confidence    Float? // General Confidence level (0-1)

  timestamp DateTime @default(now())

  // Relations
  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([detectionType])
  @@index([timestamp])
  @@map("tracking_logs")
}

enum DetectionType {
  FACE_ORIENTATION
  FACE_DETECTION_LOSS
  SECURITY_VIOLATION
}

model SessionStatistics {
  id        String @id @default(cuid())
  sessionId String @unique

  // === FACE TRACKING SUMMARY (No Duplicated Data) ===
  // Face orientation counts only - ข้อมูลสรุปจำนวนครั้ง
  faceOrientationsByDirection Json // {"LEFT": 10, "RIGHT": 15, "UP": 5, "DOWN": 8}

  // Time summary - ข้อมูลสรุปเวลา  
  timeOffScreen Int @default(0) // seconds - เวลารวมที่หันหน้าออกจากจอ

  // Face detection loss summary
  faceDetectionLoss Int @default(0) // จำนวนครั้งที่สูญเสียการตรวจจับใบหน้า
  totalLossTime     Int @default(0) // seconds - เวลารวมที่สูญเสียการตรวจจับ

  // Security violations summary
  securityViolationCount Int @default(0) // จำนวนเหตุการณ์ผิดปกติทางการสอบ (Security Violations)

  // Live Benchmark Matrix Summary (4 AI Engines: MediaPipe, YOLOv8-Face, Dlib 68-Point, OpenFace)
  benchmarkMetrics Json? // Multi-engine benchmark performance data

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("session_statistics")
}

// ==========================================
// MODEL-SPECIFIC BENCHMARK LOG TABLES
// ==========================================

model MediaPipeLog {
  id             String   @id @default(cuid())
  sessionId      String
  isDetected     Boolean  @default(true)
  fps            Float? // ความเร็ว (FPS) จาก 1000/latencyMs
  latencyMs      Float? // เวลาประมวลผลใน browser (ms)
  landmarksCount Int? // จำนวนจุด Landmarks (468)
  faceCount      Int?
  memoryMb       Float? // JS heap ร่วมของ tab ตอน snapshot (ไม่ใช่ RSS ต่อ model)
  cpuLoadPct     Float? // ไม่วัดใน browser — null
  confidence     Float? // tracking quality 0–1
  confidenceKind String?
  latencyScope   String?
  benchmarkSnapshotId String?
  measuredAt     DateTime?
  inferenceLatencyMs Float? // เวลา inference ที่เทียบข้าม engine ได้ (ms)
  comparableDetectionScore Float? // 0–1 คะแนนตรวจจับใบหน้าแบบเทียบกันได้
  snapshotSynced Boolean? // true = 4 engine รันบน frame เดียวกัน
  timestamp      DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@index([benchmarkSnapshotId])
  @@index([snapshotSynced])
  @@map("model_mediapipe_logs")
}

model Yolov8Log {
  id             String   @id @default(cuid())
  sessionId      String
  isDetected     Boolean  @default(true)
  fps            Float?
  latencyMs      Float?
  landmarksCount Int?
  faceCount      Int?
  memoryMb       Float?
  cpuLoadPct     Float?
  confidence     Float?
  confidenceKind String?
  latencyScope   String?
  benchmarkSnapshotId String?
  measuredAt     DateTime?
  inferenceLatencyMs Float?
  comparableDetectionScore Float?
  snapshotSynced Boolean?
  timestamp      DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@index([benchmarkSnapshotId])
  @@index([snapshotSynced])
  @@map("model_yolov8_logs")
}

model DlibLog {
  id             String   @id @default(cuid())
  sessionId      String
  isDetected     Boolean  @default(true)
  fps            Float?
  latencyMs      Float?
  landmarksCount Int?
  faceCount      Int?
  memoryMb       Float?
  cpuLoadPct     Float?
  confidence     Float?
  confidenceKind String?
  latencyScope   String?
  benchmarkSnapshotId String?
  measuredAt     DateTime?
  inferenceLatencyMs Float?
  comparableDetectionScore Float?
  snapshotSynced Boolean?
  timestamp      DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@index([benchmarkSnapshotId])
  @@index([snapshotSynced])
  @@map("model_dlib_logs")
}

model OpenFaceLog {
  id             String   @id @default(cuid())
  sessionId      String
  isDetected     Boolean  @default(true)
  fps            Float?
  latencyMs      Float? // client round-trip ms
  landmarksCount Int?
  faceCount      Int?
  memoryMb       Float?
  cpuLoadPct     Float?
  confidence     Float?
  confidenceKind String?
  latencyScope   String?
  benchmarkSnapshotId String?
  measuredAt     DateTime?
  serverLatencyMs Float?
  resultAgeMs    Int?
  inferenceLatencyMs Float?
  comparableDetectionScore Float?
  snapshotSynced Boolean?
  timestamp      DateTime @default(now())

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@index([benchmarkSnapshotId])
  @@index([snapshotSynced])
  @@map("model_openface_logs")
}

// ==========================================
// DETAILED BEHAVIOR FEATURE LOG (RAW DATA)
// ==========================================

enum ExperimentPhase {
  SYSTEM_STABILIZATION
  CALIBRATION
  CONTROLLED_TASK
  ROBUSTNESS_TEST
  NATURAL_TASK
}

enum FeatureValidPhase {
  faceValid
  headValid
  gazeValid
  eyeValid
}

enum BehaviorScenario {
  CENTER_SCREEN
  BRIEF_GLANCE_LEFT
  BRIEF_GLANCE_RIGHT
  SUSTAINED_LOOK_AWAY_LEFT
  SUSTAINED_LOOK_AWAY_RIGHT
  LOOK_DOWN
  LOOK_UP
  FACE_MISSING
  OCCLUSION
  MULTIPLE_FACES
  LOW_LIGHT
  DISTANCE_1M
  EYES_CLOSED_DISENGAGED
  NATURAL_READING
}

model BehaviorFeatureLog {
  id              String            @id @default(cuid())
  sessionId       String
  participantCode String?
  timestamp       DateTime          @default(now())
  elapsedMs       Int
  sampleIndex     Int
  scenario        BehaviorScenario?
  /** ช่วงการทดลอง / protocol */
  phase           ExperimentPhase   @default(NATURAL_TASK)
  /** ธ cờว่า feature แต่ละชั้นใช้ได้ (face/head/gaze/eye) */
  validPhases     FeatureValidPhase[]

  // FACE
  faceDetected   Boolean
  faceCount      Int?
  faceConfidence Float?
  bboxX          Float?
  bboxY          Float?
  bboxWidth      Float?
  bboxHeight     Float?
  faceCenterX    Float?
  faceCenterY    Float?
  faceDistanceCm Float?

  // HEAD
  headYaw            Float?
  headPitch          Float?
  headRoll           Float?
  headPoseConfidence Float?

  // GAZE
  gazeYaw        Float?
  gazePitch      Float?
  gazeConfidence Float?
  gazeLeftX      Float?
  gazeLeftY      Float?
  gazeLeftZ      Float?
  gazeRightX     Float?
  gazeRightY     Float?
  gazeRightZ     Float?

  // EYE
  leftEAR          Float?
  rightEAR         Float?
  leftEyeOpenness  Float?
  rightEyeOpenness Float?

  // FACIAL
  landmarkCount      Int?
  landmarkConfidence Float?
  actionUnitsJson    Json?

  // MODEL CONFIDENCE
  yoloConfidence      Float?
  mediapipeConfidence Float?
  dlibConfidence      Float?
  openfaceConfidence  Float?

  // QUALITY
  brightnessMean Float?
  contrastScore  Float?
  /** Laplacian variance normalized 0–1; สูง = ภาพคมชัด */
  sharpnessScore Float?
  occlusionScore Float?

  // DEVICE & RUNTIME
  deviceTier        String?
  trackingProfile   String?
  userAgent         String?
  /** true = row eligible for research export (valid, not warmup, tier/profile OK) */
  researchEligible  Boolean?
  cameraWidth       Int?
  cameraHeight      Int?
  /** FPS ของ detection loop (~10 Hz MediaPipe) */
  detectionFps      Int?
  /** FPS จาก MediaStream track settings */
  cameraStreamFps   Int?
  /** อัตรา sample ลง behavior log (Hz) — ปัจจุบัน 2 */
  sampleRateHz      Int?

  // VALIDITY & REPRODUCIBILITY
  isValid              Boolean
  invalidReason        String?
  pipelineVersion      String?
  featureSchemaVersion String?
  featureProvenance    Json?

  session TrackingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
  @@map("behavior_feature_logs")
}
